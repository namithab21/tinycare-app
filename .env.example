# Copy to .env (never commit). EXPO_PUBLIC_* values are embedded in the app bundle - public values only.

# --- App build-time (public) ---
# Crash reporting (Sentry) stays disabled until this is set.
EXPO_PUBLIC_SENTRY_DSN=
# Cloud sync. Empty = fully offline app. "same-origin" = web build served by the TinyCare server.
# For iOS/Android builds use the public https URL of your server, e.g. https://tinycare.example.com
EXPO_PUBLIC_API_URL=

# --- Server runtime (secret - set on the server only, see docs/DEPLOY.md) ---
# TINYCARE_SECRET=      # >= 32 chars:  openssl rand -hex 32
# TINYCARE_DATA_KEY=    # 64 hex chars: openssl rand -hex 32   (losing it makes stored records unreadable)
# TINYCARE_ALLOWED_ORIGINS=https://other-site.example   # only if a different website calls the API
# TINYCARE_DATA_DIR=./server/data   PORT=8080
